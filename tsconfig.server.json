{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-server",
    "rootDir": "./src/server",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "lib": ["es2020"],
    "types": ["node"],
    "noEmit": false,
    "declaration": false,
    "skipLibCheck": true
  },
  "include": ["src/server/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-server"]
}

